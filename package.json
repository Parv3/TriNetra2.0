{
  "name": "smart-proctoring-browser",
  "version": "1.0.0",
  "description": "Smart Proctoring Browser desktop application for secure MCQ assessments with AI-powered proctoring and activity tracking",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "start:backend": "node src/backend/server.js",
    "test": "node --env-file=test/.env --test \"test/*.test.js\"",
    "test:backend": "node --env-file=test/.env --test \"test/*.test.js\"",
    "test:health": "node --env-file=test/.env --test \"test/health.test.js\"",
    "test:auth": "node --env-file=test/.env --test \"test/auth.test.js\"",
    "test:assessment": "node --env-file=test/.env --test \"test/assessment.test.js\"",
    "test:timer": "node --env-file=test/.env --test \"test/timer.test.js\"",
    "test:proctor": "node --env-file=test/.env --test \"test/proctor.test.js\"",
    "test:audit": "node --env-file=test/.env --test \"test/audit.test.js\"",
    "test:m2": "node --env-file=test/.env --test \"test/main_shell.test.js\" \"test/tabManager.test.js\" \"test/searchTracker.test.js\" \"test/preload.test.js\"",
    "test:e2e": "node e2e/runner.js",
    "test:smoke": "electron src/main/index.js --smoke-test",
    "test:tf": "electron test/verify_tf.js",
    "start:server": "node src/backend/server.js",
    "fetch-models": "node scripts/fetch-models.js",
    "dist": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg",
    "dist:linux": "electron-builder --linux AppImage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@vladmandic/face-api": "^1.7.15",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "mongodb": "^7.7.0",
    "pg": "^8.23.1",
    "selfsigned": "^5.5.0",
    "uuid": "^10.0.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@tensorflow-models/coco-ssd": "^2.2.3",
    "@tensorflow/tfjs": "^4.22.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "pg-mem": "^3.0.14"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "private": true,
  "productName": "Trinetra Secure Browser",
  "build": {
    "appId": "com.trinetra.securebrowser",
    "productName": "Trinetra Secure Browser",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!**/*.test.js"
    ],
    "extraResources": [
      {
        "from": "deploy/trinetra.config.example.json",
        "to": "../trinetra.config.example.json"
      }
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "mac": {
      "category": "public.app-category.education"
    },
    "linux": {
      "category": "Education"
    }
  }
}
