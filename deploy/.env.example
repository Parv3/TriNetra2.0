# Public DNS name of the exam server (must resolve to this machine for HTTPS certificates)
TRINETRA_DOMAIN=exams.your-college.edu

# Password for the trinetra PostgreSQL user (the app's own login, not the teacher login)
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Optional: enables the AI tutor in Guided help (otherwise it uses the proctor's hints)
ANTHROPIC_API_KEY=
